{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maida-esportspubg",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://patient-bush-1abc.cloudflareaccess.com",
    "ACCESS_AUD": "bc67e918b18f7fd44fe71619e0371cf415dd4509be1b74fa3da7d740d5611b96",
    "ADMIN_EMAILS": "apengtakahashi@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maida-tournaments",
      "database_id": "3e3852b6-1eb2-44f6-89c0-50821ca56cb1",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "pubg.esukan.app",
      "custom_domain": true
    }
  ],
  "account_id": "1cf4264cff741f90be639418170e1248"
}
