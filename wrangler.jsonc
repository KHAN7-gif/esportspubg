{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maida-esportspubg",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maida-tournaments",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "pubg.esukan.app",
      "custom_domain": true
    }
  ]
}
